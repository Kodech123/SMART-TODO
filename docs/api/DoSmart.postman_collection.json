{
  "info": {
    "name": "DoSmart API",
    "description": "Smart To-Do List API. Run 'Register' or 'Login' first — it saves the JWT into the {{access_token}} collection variable, which every other request uses automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" },
    { "key": "task_id", "value": "" },
    { "key": "category_id", "value": "" },
    { "key": "reminder_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.access_token) { pm.collectionVariables.set('access_token', data.access_token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"SecurePassword123\",\n  \"display_name\": \"Test Student\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.access_token) { pm.collectionVariables.set('access_token', data.access_token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"SecurePassword123\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.task_id) { pm.collectionVariables.set('task_id', data.task_id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/tasks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Submit algorithms assignment\",\n  \"description\": \"Sorting algorithms problem set\",\n  \"category\": \"Academic\",\n  \"due_date\": \"in 3 days\",\n  \"importance_level\": 4,\n  \"estimated_effort\": 3,\n  \"enable_reminder\": true\n}"
            }
          }
        },
        {
          "name": "List Tasks",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks?status=active&sort_by=priority_score&limit=50&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks"],
              "query": [
                { "key": "status", "value": "active" },
                { "key": "category", "value": "", "disabled": true },
                { "key": "sort_by", "value": "priority_score" },
                { "key": "limit", "value": "50" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Get Task Stats",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/tasks/stats"
          }
        },
        {
          "name": "Get Task (with score breakdown)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/tasks/{{task_id}}"
          }
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/tasks/{{task_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"importance_level\": 5,\n  \"due_date\": \"tomorrow at 5pm\"\n}"
            }
          }
        },
        {
          "name": "Complete Task",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/tasks/{{task_id}}/complete"
          }
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/tasks/{{task_id}}"
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/categories"
          }
        },
        {
          "name": "Create Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.category_id) { pm.collectionVariables.set('category_id', data.category_id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_name\": \"Side Projects\",\n  \"color_hex\": \"#8E44AD\"\n}"
            }
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/categories/{{category_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"color_hex\": \"#2ECC71\"\n}"
            }
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/categories/{{category_id}}"
          }
        }
      ]
    },
    {
      "name": "Reminders",
      "item": [
        {
          "name": "List Pending Reminders",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.reminders && data.reminders.length) { pm.collectionVariables.set('reminder_id', data.reminders[0].reminder_id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/reminders?status=pending&limit=50&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reminders"],
              "query": [
                { "key": "status", "value": "pending" },
                { "key": "limit", "value": "50" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Snooze Reminder",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/reminders/{{reminder_id}}/snooze?minutes=30",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reminders", "{{reminder_id}}", "snooze"],
              "query": [{ "key": "minutes", "value": "30", "description": "one of 15, 30, 60, 120" }]
            }
          }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Get Settings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/user/settings"
          }
        },
        {
          "name": "Update Settings",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/user/settings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active_hours_start\": \"07:00:00\",\n  \"active_hours_end\": \"23:00:00\",\n  \"notification_opt_in\": true\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Push",
      "item": [
        {
          "name": "Subscribe",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/push/subscribe",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subscription\": {\n    \"endpoint\": \"https://fcm.googleapis.com/fcm/send/example-endpoint\",\n    \"keys\": {\n      \"p256dh\": \"example-p256dh-key\",\n      \"auth\": \"example-auth-key\"\n    }\n  }\n}"
            }
          }
        },
        {
          "name": "Unsubscribe",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/push/unsubscribe",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"endpoint\": \"https://fcm.googleapis.com/fcm/send/example-endpoint\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "auth": { "type": "noauth" },
        "url": "{{baseUrl}}/health"
      }
    }
  ]
}
