# Database
DATABASE_URL=sqlite:///./dev.db
TEST_DATABASE_URL=sqlite:///./test.db

# Auth
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Notifications: "log" (dev, prints to console) or "webpush" (real Web Push via VAPID)
# To enable real push notifications, generate a VAPID key pair (`vapid --gen` from the
# py-vapid package, already in requirements.txt), set NOTIFICATION_TRANSPORT=webpush,
# and copy VAPID_PUBLIC_KEY into frontend/.env as VITE_VAPID_PUBLIC_KEY too.
NOTIFICATION_TRANSPORT=log
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=mailto:support@dosmart.app

# Scheduler
SCHEDULER_TIMEZONE=UTC
